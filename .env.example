# CogniMate 智伴 - 环境变量配置模板
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入你的实际配置值
# 3. 确保 .env 在 .gitignore 中，不要提交到仓库

# ============================================
# 飞书应用配置（必填）
# 在 https://open.feishu.cn/app 创建企业自建应用获取
# ============================================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书用户ID（接收消息的用户）
# 可通过飞书开放平台获取用户的 open_id
FEISHU_USER_ID=ou_xxxxxxxxxxxxxxxx

# ============================================
# AI 服务配置（必填其一）
# ============================================
# Kimi API Key（推荐）
# 在 https://platform.moonshot.cn/ 获取
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 或使用其他 OpenAI 兼容的 API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# 服务端配置（可选）
# ============================================
# 服务监听端口（默认：8000）
SERVER_PORT=8000

# 服务监听主机（默认：0.0.0.0）
SERVER_HOST=0.0.0.0

# 调试模式（开发时设为 true）
DEBUG=false

# ============================================
# 提醒配置（可选）
# ============================================
# 用户昵称（提醒消息中使用）
USER_NICKNAME=主人

# 时区设置（默认：Asia/Shanghai）
TIMEZONE=Asia/Shanghai

# ============================================
# 数据库配置（可选，一般无需修改）
# ============================================
# SQLite 数据库文件路径
DATABASE_URL=sqlite:///./cognimate.db
