# CogniMate 私密文件保护
# 这些文件包含个人隐私信息，请勿上传到GitHub

# 私密文件夹
private/

# 包含个人隐私的原始文件
*_私密版.md

# 用户ID和敏感信息
*_user_*.md

# 本地配置文件（可能包含密钥）
*.env
.env.local
.env.*.local

# 数据库文件（包含个人数据）
*.db
*.sqlite
*.sqlite3

# 日志文件（可能包含敏感信息）
*.log
logs/

# 临时文件
tmp/
temp/
*.tmp

# 系统文件
.DS_Store
Thumbs.db

# IDE配置（可选）
.vscode/
.idea/
*.swp
*.swo

# 依赖（如果本地安装）
node_modules/
__pycache__/
*.pyc
